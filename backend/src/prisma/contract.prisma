// use prisma-8
enum Status {
  OPEN
  ACCEPTED
}

model User {
  id               Int           @id @default(autoincrement())
  googleId         String?       @unique
  first_name       VarChar(50)?
  last_name        VarChar(50)?
  email            VarChar(255)? @unique
  passwordHash     String?
  postedRides      Ride[]        @relation("postedRides")
  acceptedRides    Ride[]        @relation("acceptedRides")
  sentMessages     Message[]     @relation("sentMessages")
  receivedMessages Message[]     @relation("receivedMessages")

  @@map("users")
}

model Ride {
  id                  Int                        @id @default(autoincrement())
  title               VarChar(50)
  departureLocation   VarChar(255)
  destinationLocation VarChar(255)
  departure           Timestamp
  description         String
  price               Numeric(10, 2)
  status              Status                     @default(OPEN)
  createdAt           Timestamp                  @default(now())
  updatedAt           temporal.updatedAtString()
  posterId            Int
  acceptorId          Int?
  poster              User                       @relation("postedRides", fields: [posterId], references: [id], onDelete: Cascade)
  acceptor            User?                      @relation("acceptedRides", fields: [acceptorId], references: [id], onDelete: SetNull)
  messages            Message[]                  @relation("messages")

  @@map("rides")
}

model Message {
  id          Int       @id @default(autoincrement())
  rideId      Int
  sender_id   Int?
  receiver_id Int?
  content     String
  createdAt   Timestamp @default(now())
  sender      User?     @relation("sentMessages", fields: [sender_id], references: [id], onDelete: SetNull)
  receiver    User?     @relation("receivedMessages", fields: [receiver_id], references: [id], onDelete: SetNull)
  ride        Ride      @relation("messages", fields: [rideId], references: [id], onDelete: Cascade)

  @@map("messages")
}
